# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Security & Authentication
JWT_SECRET=super-secret-development-jwt-key-replace-in-production
JWT_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://nexdev_user:nexdev_secure_pass@localhost:5432/nexdev_db
POSTGRES_USER=nexdev_user
POSTGRES_PASSWORD=nexdev_secure_pass
POSTGRES_DB=nexdev_db

# Redis Caching (Optional)
REDIS_URL=redis://localhost:6379

# Client Configuration
VITE_API_BASE_URL=http://localhost:5000/api
